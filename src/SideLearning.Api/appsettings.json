{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:O}] [{Level:u3}] {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=sidelearning;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "side-learning",
    "Audience": "side-learning-clients",
    "SigningKey": "CHANGE_ME_DEV_ONLY_USE_ENV_32CHARS_MIN____",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SessionDesigner": {
    "BaseUrl": "http://localhost:8010",
    "SharedSecret": "CHANGE_ME_SESSION_DESIGNER_SHARED_SECRET",
    "HttpTimeoutSeconds": 120,
    "EnableWorker": true
  },
  "PublicApi": {
    "BaseUrl": "http://localhost:5207"
  }
}
